{
  "expo": {
    "name": "Floating Teleprompter",
    "slug": "floating-teleprompter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ramimaalouf.floatingteleprompter",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "The teleprompter listens to you so the script scrolls at your pace.",
        "NSSpeechRecognitionUsageDescription": "The teleprompter finds your place in the script from the words you say."
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-router"
    ],
    "scheme": "floatingteleprompter"
  }
}
