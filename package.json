{
  "name": "floating-teleprompter",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.1.0",
    "expo-dev-client": "~58.0.22",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
